            "summarizeBy": "none"
          },
          {
            "name": "verified_on",
            "dataType": "string",
            "lineageTag": "47c889df-05e6-4cb0-ac60-38b6ae33efd2",
            "sourceColumn": "verified_on",
            "summarizeBy": "none"
          },
          {
            "name": "evidence_coverage_pct",
            "dataType": "double",
            "lineageTag": "255b6655-09ea-4bd6-91a0-ee4af81b09cb",
            "sourceColumn": "evidence_coverage_pct",
            "summarizeBy": "none"
          },
          {
            "name": "Platform",
            "dataType": "string",
            "expression": "Products[brand] & \" \" & Products[family] & \" / \" & Products[variant]",
            "lineageTag": "75825ed7-48df-4a69-aebf-ba3625bdc7f2",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "FleetFit",
            "dataType": "string",
            "expression": "SWITCH(TRUE(), NOT ISBLANK(Products[max_ram_gb]) && Products[max_ram_gb] < 64, \"No match\", NOT ISBLANK(Products[weight_kg]) && Products[weight_kg] > 1.5, \"No match\", NOT ISBLANK(Products[ram_upgradeable]) && Products[ram_upgradeable] = 0, \"No match\", ISBLANK(Products[max_ram_gb]) || ISBLANK(Products[weight_kg]) || ISBLANK(Products[ram_upgradeable]), \"Unresolved\", \"Candidate - verify SKU\")",
            "lineageTag": "710a6473-7ffa-4fca-ac56-265eea220e95",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "TravelFit",
            "dataType": "string",
            "expression": "SWITCH(TRUE(), NOT ISBLANK(Products[max_ram_gb]) && Products[max_ram_gb] < 32, \"No match\", NOT ISBLANK(Products[weight_kg]) && Products[weight_kg] > 1.3, \"No match\", ISBLANK(Products[max_ram_gb]) || ISBLANK(Products[weight_kg]), \"Unresolved\", \"Candidate - verify SKU\")",
            "lineageTag": "fec961f8-ea1d-4132-88f0-a813fd9f80a5",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "lineageTag": "bbb90a6a-be70-49cc-b0dc-948e97ac46ad",
        "measures": [
          {
            "name": "Platform variants",
            "expression": "COUNTROWS(Products)",
            "formatString": "0",
            "lineageTag": "0f5df954-2c03-4c8e-be50-de3918ad76a1"
          },
          {
            "name": "Product families",
            "expression": "COUNTROWS(SUMMARIZE(Products, Products[brand], Products[family]))",
            "formatString": "0",
            "lineageTag": "1a0ac7b1-cadb-4f35-a71f-4413026b2870"
          },
          {
            "name": "Brands tracked",
            "expression": "DISTINCTCOUNT(Products[brand])",
            "formatString": "0",
            "lineageTag": "df6ed7e3-b0fc-4dbc-ab20-b2a09383457d"
          },
          {
            "name": "Evidence coverage %",
            "expression": "AVERAGE(Products[evidence_coverage_pct])",
            "formatString": "0",
            "lineageTag": "192ae492-d552-4620-bb15-09efab5b4938"
          },
          {
            "name": "Starting weight kg",
            "expression": "MIN(Products[weight_kg])",
            "formatString": "0.000",
            "lineageTag": "3ca62099-9dc0-460f-854d-cdff63ace5da"
          },
          {
            "name": "Max memory GB",
            "expression": "MAX(Products[max_ram_gb])",
            "formatString": "0",
            "lineageTag": "3e446a84-6d78-4da2-8a8c-44f031009397"
          },
          {
            "name": "Fleet candidates",
            "expression": "CALCULATE(COUNTROWS(Products), Products[FleetFit] = \"Candidate - verify SKU\")",
            "formatString": "0",
            "lineageTag": "f292da01-0e16-4b68-bc90-30bbb04401f8"
          }
        ],
        "partitions": [
          {
            "name": "Products",
